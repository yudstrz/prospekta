{
  "name": "prospekta",
  "displayName": "Prospekta Business Intelligence & Agent",
  "version": "1.0.0",
  "description": "Universal MCP Plugin untuk akses Lokasi, PDF, Website, dan Company AI Agent Prospekta dengan penegakan RBAC.",
  "author": "Prospekta",
  "homepage": "https://github.com/yudstrz/prospekta",
  "mcp": {
    "servers": {
      "prospekta": {
        "transport": "streamable-http",
        "url": "${PROSPEKTA_URL}/customer-reach/api/mcp/user",
        "headers": {
          "Authorization": "Bearer ${PROSPEKTA_TOKEN}"
        }
      }
    }
  }
}
