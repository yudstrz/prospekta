# Internal Portal Authentication (Single-Secret Gate)
ADMIN_PASSWORD="prospepkta2026!"

# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@ep-curly-bread-bdznrhfs-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# AI Models & Provider Routing (Server-only, jangan dikirim ke client)
# Default provider platform: agnes (bawaan .env) | gemini | openai | claude
AI_PROVIDER="agnes"
# Mode per environment: "latest" (dev/staging) atau "pinned" (production snapshot)
AI_MODEL_MODE="latest"

# --- Google Gemini ---
GEMINI_API_KEY="your-gemini-api-key"
# Dev/Staging: pakai rolling alias "gemini-flash-latest"
GEMINI_MODEL="gemini-flash-latest"
# Production: pin versi eksplisit saat naik production (ubah AI_MODEL_MODE="pinned")
GEMINI_MODEL_PINNED="gemini-3.8-flash"
GEMINI_FALLBACK_MODEL="gemini-flash-lite-latest"

# --- OpenAI (GPT) ---
OPENAI_API_KEY="your-openai-api-key"
OPENAI_MODEL="auto"
OPENAI_MODEL_PINNED="gpt-6.2-sol"
OPENAI_FALLBACK_MODEL="gpt-6-luna"

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY="your-anthropic-claude-api-key"
# Dev/Staging: "auto" memanggil GET /v1/models, filter by line (CLAUDE_MODEL_LINE), cache 24 jam
CLAUDE_MODEL="auto"
CLAUDE_MODEL_LINE="sonnet"
# Production: pin versi eksplisit saat AI_MODEL_MODE="pinned"
CLAUDE_MODEL_PINNED="claude-sonnet-5-5"
CLAUDE_FALLBACK_MODEL="claude-haiku-5-5"

# --- Opsional Override per Role RBAC (admin / user) ---
# GEMINI_ADMIN_MODEL="gemini-3.8-flash"
# GEMINI_USER_MODEL="gemini-flash-latest"
# OPENAI_ADMIN_MODEL="gpt-6.2-astra"
# OPENAI_USER_MODEL="gpt-6.2-sol"
# CLAUDE_ADMIN_MODEL="claude-sonnet-5-5"
# CLAUDE_USER_MODEL="claude-haiku-5-5"

AGENT_API_KEY="your-agent-flash-api-key"

# Real Google Maps Data (Google Places API)
GOOGLE_MAPS_API_KEY="your-google-places-api-key"

# Meeting Booking Link (Google Calendar)
NEXT_PUBLIC_CALENDAR_URL="https://calendar.google.com"

# Cron & Automation (cron-job.org / GitHub Actions)
# Kunci rahasia untuk memproteksi endpoint /api/cron/sync
CRON_SECRET="generate-a-strong-secret-token"

# Opsional: Jika ingin endpoint /api/cron/sync men-trigger GitHub Actions workflow secara otomatis
GITHUB_TOKEN="ghp_your_github_personal_access_token_here"
GITHUB_REPO="yudstrz/prospekta"

# SMTP Email Configuration (Nodemailer / Cold Outreach)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM="your-email@gmail.com"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"


# Multi-tenant
SESSION_SECRET=ganti-dengan-string-acak-panjang
SETTINGS_ENC_KEY=ganti-dengan-string-acak-panjang
